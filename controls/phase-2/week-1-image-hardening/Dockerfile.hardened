# Stage 1: Build — install dependencies with a full toolchain
FROM python:3.9-slim AS build
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

# Stage 2: Hardened runtime — minimal image, no shell, no package manager
FROM cgr.dev/chainguard/python:latest
WORKDIR /app

# Create a non-root user
RUN adduser -D -u 1000 appuser

# Copy only the application and Python packages from the build stage
COPY --from=build /app /app
COPY --from=build /usr/local/lib/python3.9/site-packages /usr/local/lib/python3.9/site-packages

# Ensure uploads directory exists and is writable by the non-root user
RUN mkdir -p /app/static/uploads && chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

EXPOSE 5000

CMD ["python", "app.py"]
